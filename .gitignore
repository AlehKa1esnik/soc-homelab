# .gitignore — страховка, а не замена проверке: перед каждым коммитом смотри git status.
# Комментарий в .gitignore — только отдельной строкой, начиная с #.

# --- Секреты: никогда не коммитить ---
*.pass
client.keys
*.key
*.pem
*.p12
*.pfx
*.kdbx
id_*
*_ed25519
*_ed25519.pub
wazuh-install-files.tar
wazuh-passwords.txt
.env
private/

# --- Диски, образы, архивы ---
*.qcow2
*.iso
*.img
*.7z

# --- Выгрузки трафика и журналов: публиковать только осознанно, после проверки ---
*.pcap
*.pcapng
*.evtx

# --- Личные отчёты ---
*.pdf

# --- Мусор ОС, Python и редакторов ---
__pycache__/
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/
